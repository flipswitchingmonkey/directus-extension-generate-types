{
  "name": "directus-extension-generate-types",
  "version": "0.6.1-maqq-1.1",
  "license": "MPL-2.0",
  "description": "Generates types from Directus field definitions. Forked from https://github.com/maltejur/directus-extension-generate-types",
  "author": "Michael Auerswald",
  "repository": "https://github.com/flipswitchingmonkey/directus-extension-generate-types",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-module"
  ],
  "directus:extension": {
    "type": "module",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0",
    "hidden": false
  },
  "scripts": {
    "build": "directus-extension build",
    "watch": "directus-extension build --watch",
    "dev": "directus-extension build --watch --no-minify"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.0.2",
    "@directus/types": "13.3.1",
    "@types/prismjs": "1.26.5",
    "axios": "1.13.2",
    "typescript": "5.9.3",
    "vue": "3.5.24"
  },
  "dependencies": {
    "prismjs": "1.30.0"
  },
  "files": [
    "dist"
  ]
}
